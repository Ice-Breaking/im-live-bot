# 复制成 .env 后填入真实值：cp .env.example .env
# .env 已在 .gitignore 中，不会进版本库；本文件只有键名，没有真实值

# 飞书自建应用：开放平台 → 凭证与基础信息
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 机器人自己的 open_id（ou_ 开头），用于判断群聊是否 @ 了机器人
FEISHU_BOT_OPEN_ID=

# 阶跃星辰模型
STEP_API_KEY=
STEP_BASE_URL=https://api.stepfun.com/step_plan/v1
STEP_MODEL=step-3.7-flash

# 允许使用机器人的飞书用户 open_id（ou_ 开头），多个用逗号分隔
ALLOWED_OPEN_IDS=

# 启用哪些入口：feishu（飞书长连接）、terminal（终端交互），可只填一个，也可逗号分隔同时启用
ENABLED_CHANNELS=feishu
# 终端入口的身份，自动并入白名单，不需要再写进 ALLOWED_OPEN_IDS
TERMINAL_USER_OPEN_ID=ou_terminal
